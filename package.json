{
  "name": "notemind",
  "version": "1.2.0",
  "private": true,
  "description": "A simple desktop notepad for Markdown and Python.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.cjs",
    "package:update": "node scripts/package-update.cjs",
    "release": "node scripts/release.cjs",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "preflight": "npm test",
    "package:win": "node scripts/package-win.cjs"
  },
  "dependencies": {
    "docx": "^9.15.0",
    "electron-updater": "6.8.12",
    "highlight.js": "11.12.0",
    "image-size": "2.1.0",
    "koffi": "^3.3.2",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stream-json": "3.9.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.seancheren.notemind",
    "productName": "NoteMind",
    "directories": {
      "output": "dist/installer",
      "buildResources": "build"
    },
    "artifactName": "NoteMind-${version}-win-x64-setup.${ext}",
    "win": {
      "icon": "src/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "nm",
          "name": "NoteMind document",
          "description": "NoteMind document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "NoteMind",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chere005",
        "repo": "NoteMind"
      }
    ]
  }
}
